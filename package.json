{
  "name": "@iswangh/eslint-config",
  "type": "module",
  "version": "0.2.4",
  "description": "基于 @antfu/eslint-config 的 ESLint 扁平配置，添加了自定义规则（TypeScript 命名约定、Vue TypeScript 强制、未使用导入检测等），支持 JavaScript 和 TypeScript 配置文件",
  "author": "iswangh <https://gitee.com/iswangh>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://gitee.com/iswangh/eslint-config.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "eslint",
    "eslint-config",
    "@antfu/eslint-config"
  ],
  "exports": {
    ".": {
      "types": "./index.ts",
      "import": "./index.js"
    }
  },
  "main": "./index.js",
  "files": [
    "README.md",
    "index.js",
    "index.ts",
    "src"
  ],
  "scripts": {
    "prepare": "husky",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "release": "cross-env CI=true semantic-release",
    "release:dry-run": "semantic-release --dry-run"
  },
  "peerDependencies": {
    "@unocss/eslint-plugin": "^66.0.0",
    "eslint": "^9.0.0 || ^10.0.0"
  },
  "peerDependenciesMeta": {
    "@unocss/eslint-plugin": {
      "optional": true
    }
  },
  "dependencies": {
    "@antfu/eslint-config": "^8.2.0",
    "eslint-plugin-format": "^2.0.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jiti": "^2.6.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@iswangh/commitlint-config": "^0.2.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/node": "^25.6.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "semantic-release": "^25.0.3",
    "typescript": "^6.0.2"
  },
  "volta": {
    "node": "24.15.0"
  }
}
